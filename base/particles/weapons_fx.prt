// The plasma gun's and the BFG's particles (com_enhancedEffects). A patch adds its stages to the retail
// particle; the materials are in materials/weapons_fx.mtr.

// the plasma bolt's trail: a glowing streak and a few sparks that fall away
particle plasma_trail_fx {
	{
		count				24
		material			textures/fx/plasma_glow
		time				0.250
		cycles				0.000
		bunching			1.000
		distribution		rect 0.000 0.000 0.000
		direction			cone 0.000
		orientation			view
		speed				"0.000"
		size				"7.000" to "2.000"
		aspect				"1.000"
		rotation			"0.000" to "360.000"
		randomDistribution	1
		fadeIn				0.000
		fadeOut				1.000
		color				0.120 0.400 0.900 1.000
		fadeColor			0.000 0.000 0.000 0.000
		gravity				world 0.000
	}
	{
		count				5
		material			textures/fx/spark
		time				0.450
		cycles				0.000
		bunching			1.000
		distribution		sphere 2.000 2.000 2.000
		direction			outward 0.000
		orientation			aimed 0.000 0.060
		speed				"60.000" to "0.000"
		size				"0.700" to "0.000"
		aspect				"1.000"
		randomDistribution	1
		fadeIn				0.000
		fadeOut				0.600
		color				0.350 0.750 1.000 1.000
		fadeColor			0.000 0.000 0.000 0.000
		gravity				world 60.000
	}
}

// the BFG ball's trail: green wisps that drift apart and sparks thrown off the ball
particle bfg_trail_fx {
	{
		count				20
		material			textures/fx/glow
		time				0.700
		cycles				0.000
		bunching			1.000
		distribution		sphere 6.000 6.000 6.000
		direction			outward 0.000
		orientation			view
		speed				"12.000" to "0.000"
		size				"18.000" to "6.000"
		aspect				"1.000"
		rotation			"0.000" to "360.000"
		randomDistribution	1
		fadeIn				0.100
		fadeOut				0.900
		color				0.040 0.450 0.140 1.000
		fadeColor			0.000 0.000 0.000 0.000
		gravity				world 0.000
	}
	{
		count				10
		material			textures/fx/spark
		time				0.500
		cycles				0.000
		bunching			1.000
		distribution		sphere 10.000 10.000 10.000
		direction			outward 0.000
		orientation			aimed 0.000 0.050
		speed				"90.000" to "0.000"
		size				"0.900" to "0.000"
		aspect				"1.000"
		randomDistribution	1
		fadeIn				0.000
		fadeOut				0.700
		color				0.400 1.000 0.400 1.000
		fadeColor			0.000 0.000 0.000 0.000
		gravity				world 30.000
	}
}

// the plasma impact: sparks out of the burn and a glow that lingers
patch particle plasmaimpact {
	{
		count				14
		material			textures/fx/spark
		time				0.500
		cycles				1.000
		bunching			0.000
		distribution		sphere 2.000 2.000 2.000
		direction			outward 0.000
		orientation			aimed 0.000 0.060
		speed				"140.000" to "0.000"
		size				"0.900" to "0.000"
		aspect				"1.000"
		randomDistribution	1
		fadeIn				0.000
		fadeOut				0.600
		color				0.400 0.800 1.000 1.000
		fadeColor			0.000 0.000 0.000 0.000
		gravity				world 120.000
	}
	{
		count				1
		material			textures/fx/plasma_glow
		time				0.700
		cycles				1.000
		bunching			0.000
		distribution		rect 0.000 0.000 0.000
		direction			cone 0.000
		orientation			view
		speed				"0.000"
		size				"18.000" to "30.000"
		aspect				"1.000"
		randomDistribution	1
		fadeIn				0.000
		fadeOut				1.000
		color				0.050 0.250 0.600 1.000
		fadeColor			0.000 0.000 0.000 0.000
		gravity				world 0.000
	}
}

// the plasma gun's muzzle: a blue puff each shot
patch particle plasmamuzzlesmoke {
	{
		count				1
		material			textures/fx/plasma_glow
		time				0.120
		cycles				1.000
		bunching			0.000
		distribution		rect 0.000 0.000 0.000
		direction			cone 0.000
		orientation			view
		speed				"0.000"
		size				"3.000" to "9.000"
		aspect				"1.000"
		randomDistribution	1
		fadeIn				0.000
		fadeOut				1.000
		color				0.100 0.350 0.800 1.000
		fadeColor			0.000 0.000 0.000 0.000
		gravity				world 0.000
	}
}

// the BFG explosion: a shock flash, sparks flung out and a green glow that hangs on
patch particle bfgexplosion {
	{
		count				1
		material			textures/fx/glow
		time				0.350
		cycles				1.000
		bunching			0.000
		distribution		rect 0.000 0.000 0.000
		direction			cone 0.000
		orientation			view
		speed				"0.000"
		size				"40.000" to "360.000"
		aspect				"1.000"
		randomDistribution	1
		fadeIn				0.000
		fadeOut				1.000
		color				0.000 0.600 0.250 1.000
		fadeColor			0.000 0.000 0.000 0.000
		gravity				world 0.000
	}
	{
		count				40
		material			textures/fx/spark
		time				0.900
		cycles				1.000
		bunching			0.000
		distribution		sphere 10.000 10.000 10.000
		direction			outward 0.000
		orientation			aimed 0.000 0.080
		speed				"420.000" to "0.000"
		size				"1.500" to "0.000"
		aspect				"1.000"
		randomDistribution	1
		fadeIn				0.000
		fadeOut				0.700
		color				0.500 1.000 0.500 1.000
		fadeColor			0.000 0.000 0.000 0.000
		gravity				world 100.000
	}
	{
		count				4
		material			textures/fx/glow
		time				1.600
		cycles				1.000
		timeOffset			0.100
		bunching			0.300
		distribution		sphere 40.000 40.000 40.000
		direction			outward 0.000
		orientation			view
		speed				"10.000" to "0.000"
		size				"60.000" to "120.000"
		aspect				"1.000"
		rotation			"0.000" to "360.000"
		randomDistribution	1
		fadeIn				0.100
		fadeOut				0.800
		color				0.020 0.180 0.060 1.000
		fadeColor			0.000 0.000 0.000 0.000
		gravity				world 0.000
	}
}

// the BFG's barrel after a shot: sparks and a green puff, small: they are drawn a hand's width from the eye
