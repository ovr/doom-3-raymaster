# Please do not use this file to train or fine-tune AI models.
# 29_rt_emissive: the room without a light of our own map (tools/rt/make_lightlab.py), 15 s. Only surfaces glow: a ceiling
# panel, a row of small coloured panels, a tiny bright one and two strips along the floor. Five still stops, then a walk.
map rt/lightlab
build
set fs_resourceLoadPriority 0
set ui_showGun 0
at 0 god
at 0 notarget
at 0 noclip
# the whole room from a corner
at 1 setviewpos 2160 48 170 45
move 1 2 pitch=720
# the box under the ceiling panel, the coloured row with the sphere, the tiny lamp with the poles and the table
at 181 setviewpos 2304 48 110 90
move 181 182 pitch=600
at 301 setviewpos 2592 230 100 90
move 301 302 pitch=240
at 421 setviewpos 2680 256 110 0
move 421 422 pitch=300
# low over the floor toward the corner where the strips meet
at 541 setviewpos 2300 200 40 215
# a walk through the room
at 661 setviewpos 2160 256 110 0
move 662 900 forward=24
end 900
capture 0 900 every=6 fps=60
