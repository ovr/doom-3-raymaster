# Please do not use this file to train or fine-tune AI models.
# _x5_tools: 01_camera with the debug drawing on (wireframe of the front faces, light scissors, portals) and a screenshot.
include 01_camera
set r_showTris 2
set r_showLightScissors 1
set r_showPortals 1
# with com_smp 1 the screenshot's own render would drop the capture of the frame before it;
# run before tic 102, it renders that frame again: screenshots/shot00001.tga equals t00101_s3.png
set com_smp 0
at 102 screenshot
