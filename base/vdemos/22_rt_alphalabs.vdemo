# Please do not use this file to train or fine-tune AI models.
# 22_rt_alphalabs: alphalabs1, five stops for reflections: the blue corridor under a red light, the orange machinery
# on grate panels, the lit door by the steam and stairs, the red corridor, the orange and teal office.
map game/alphalabs1
set ui_showGun 0
at 0 god
at 0 notarget
at 0 noclip
# blue corridor: a dolly along the grate floor
at 1 setviewpos 256 3444 26 90
move 1 300 forward=6 pitch=1
# machinery: a pan over the orange grates
at 301 setviewpos -548 2692 70 245
move 301 600 yaw=-8 pitch=2
# door and stairs: a pan through the steam
at 601 setviewpos -1032 1984 134 70
move 601 900 yaw=8 pitch=2
# red corridor: a dolly toward the red frames
at 901 setviewpos -1040 4144 -50 180
move 901 1200 forward=6 pitch=1
# office: a pan across the teal screens
at 1201 setviewpos -1345 3734 70 5
move 1201 1500 yaw=-8 pitch=2
end 1500
capture 5 1500 every=10 fps=60
