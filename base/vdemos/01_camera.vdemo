# 01_camera: delta3, 30 s run. Flashlight sweeps, doors, falling ceiling panels, a jump, a jammed door with sparks, a crouched turn, stairs, weapon switches, the decon chamber cycle.
map game/delta3
at 0 god
at 0 notarget
at 1 setviewpos 2976 -1000 -376 90
at 2 give all
impulse 3 2
impulse 40 16
move 30 90 yaw=60
move 90 150 yaw=-120
move 150 180 yaw=120 pitch=-40
move 180 210 pitch=40
at 190 trigger mal_func_door_23
move 240 330 forward=127 run
# door 205 is locked=2: the first trigger unlocks it, the second opens it
at 342 trigger func_door_205
move 342 382 yaw=150 pitch=20
# triggered monsters attack even with notarget; removed while out of view
at 372 killmonsters
move 392 452 yaw=-190 pitch=-13
move 452 514 forward=127 right=-43 run
at 480 trigger func_door_205
move 514 534 forward=127 run
# stopping in trigger_once_8 drops the ceiling panels ahead, with sparks
move 540 560 pitch=-75
move 570 600 pitch=50
impulse 590 3
move 600 735 forward=127 run
move 614 616 jump
at 640 trigger func_door_207
# door 209 is jammed: it opens a crack and sparks
at 725 trigger func_door_209
move 735 765 forward=127 yaw=180 run
move 765 775 forward=127 run
move 775 800 pitch=-40 crouch
move 800 830 yaw=-360 pitch=40 crouch
move 830 840 crouch
move 840 899 forward=127 right=81 run
move 899 960 forward=127
move 905 925 pitch=60
move 935 955 pitch=-60
move 960 990 forward=127 yaw=160
move 990 1061 forward=127 run
move 1061 1071 forward=127 yaw=60 run
impulse 1060 8
at 1080 trigger func_door_210
move 1071 1150 forward=127 run
move 1150 1170 forward=60
move 1170 1260 yaw=180
move 1190 1215 pitch=-40
move 1215 1240 pitch=40
at 1250 trigger decondoor1
impulse 1300 5
move 1260 1325 forward=127
move 1325 1355 yaw=360
# backing into decon_trigger1 starts the chamber cycle: doors close, red light, misters move
move 1355 1422 forward=-127
move 1440 1470 yaw=180
move 1450 1470 pitch=-30
move 1560 1650 yaw=-120
move 1650 1680 pitch=-40
move 1700 1740 pitch=40
move 1740 1800 yaw=60
end 1800
capture 0 340 every=10 fps=60
capture 100 107
capture 260 265
capture 360 1800 every=60 fps=60
capture 818 823
capture 1335 1340
