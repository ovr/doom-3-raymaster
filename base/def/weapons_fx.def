entityDef fx_plasma_impact {
	// the flash
	"e1_kind"		"flash"
	"e1_lifeMin"	"0.14"
	"e1_size"		"8"
	"e1_sizeEnd"	"30"
	"e1_intensity"	"14"
	"e1_color"		"0.35 0.65 1"
	"e1_offset"		"3"
	"e1_fadeDepth"	"8"
	// the glow that lingers
	"e2_kind"		"glow"
	"e2_lifeMin"	"0.5"
	"e2_size"		"18"
	"e2_sizeEnd"	"8"
	"e2_intensity"	"2"
	"e2_color"		"0.15 0.4 1"
	"e2_offset"		"4"
	"e2_fadeDepth"	"10"
	// molten sparks: they fall, bounce off the world and cool
	"e3_kind"		"spark"
	"e3_count"		"22"
	"e3_speedMin"	"120"
	"e3_speedMax"	"480"
	"e3_cone"		"75"
	"e3_lifeMin"	"0.5"
	"e3_lifeMax"	"1.4"
	"e3_size"		"0.7"
	"e3_gravity"	"800"
	"e3_drag"		"0.6"
	"e3_bounce"		"0.5"
	"e3_heat"		"1"
	"e3_intensity"	"4"
	"e3_offset"		"1"
	// the spot it burnt, cooling
	"e4_kind"		"mark"
	"e4_lifeMin"	"2.6"
	"e4_size"		"7"
	"e4_heat"		"0.8"
	"e4_intensity"	"1.5"
}
