	"e2_size"		"90"
	"e2_intensity"	"0.3"
	"e2_color"		"0.15 1 0.25"
	"e2_fadeDepth"	"24"
	// what it throws off
	"e3_kind"		"spark"
	"e3_rate"		"700"
	"e3_spread"		"15"
	"e3_inherit"	"1"
	"e3_drag"		"3"
	"e3_speedMin"	"40"
	"e3_speedMax"	"260"
	"e3_cone"		"180"
	"e3_lifeMin"	"0.15"
	"e3_lifeMax"	"0.6"
	"e3_size"		"0.5"
	"e3_sizeEnd"	"0.5"
	"e3_intensity"	"4"
	"e3_vary"		"0.8"
	"e3_color"		"0.2 1 0.3"
	"e4_kind"		"spark"
	"e4_rate"		"60"
	"e4_spread"		"8"
	"e4_speedMin"	"100"
	"e4_speedMax"	"420"
	"e4_cone"		"180"
	"e4_inherit"	"0.6"
	"e4_lifeMin"	"0.3"
	"e4_lifeMax"	"0.9"
	"e4_size"		"0.9"
