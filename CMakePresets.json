{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 30, "patch": 0 },
  "configurePresets": [
    {
      "name": "vs2022-x64",
      "displayName": "Visual Studio 2022 (x64)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "ninja-x64",
      "displayName": "Ninja Multi-Config (x64, run from an x64 Native Tools prompt)",
      "generator": "Ninja Multi-Config",
      "architecture": { "value": "x64", "strategy": "external" },
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug",   "configurePreset": "vs2022-x64", "configuration": "Debug" },
    { "name": "release", "configurePreset": "vs2022-x64", "configuration": "Release" },
    { "name": "retail",  "configurePreset": "vs2022-x64", "configuration": "Retail" },
    { "name": "ninja-debug",   "configurePreset": "ninja-x64", "configuration": "Debug" },
    { "name": "ninja-release", "configurePreset": "ninja-x64", "configuration": "Release" },
    { "name": "ninja-retail",  "configurePreset": "ninja-x64", "configuration": "Retail" }
  ]
}
